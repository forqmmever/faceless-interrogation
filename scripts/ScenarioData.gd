# ---------- 查询接口 ----------
func get_background(id: String) -> Dictionary:
	# ★ 第五十三轮：这里**不过滤草稿** —— 存档里可能记着一套后来被停用的背景
	#   （玩家禁用之后又去「继续游戏」），那时仍然要能取到它、把这一局走完。
	#   过滤只发生在「抽新的一局」（background_ids）。
	for b in BACKGROUNDS:
		if b["id"] == id:
			return b
	return BACKGROUNDS[0]

# ---------------- 第五十三轮：草稿 / 启用 ----------------
# 一套背景可以标 `enabled: false`（编辑器里叫「草稿」）——
# 它**不参与抽取**（游戏不会抽到半成品）、也不进自动化测试的内容校验。
#   ★ 缺省（没写这个键）= **启用** —— 出厂那四套不用补字段，向后兼容。
#   ★ 为什么需要这个：新建一套背景时它是空的（没有档案卡 / 题目 / 事实 / 短信），
#     而开局是**随机抽背景**的 —— 抽到空背景会直接崩
#     （归类环节要 12 张卡、每轮要恰好 1 道盲区题、短信要按轮揭示事实）。
func bg_enabled(bg: Dictionary) -> bool:
	return bg.get("enabled", true) != false

# 全部背景（含草稿）—— 编辑器 / 导出用
func all_backgrounds() -> Array:
	return BACKGROUNDS

# 只有「已启用」的那些 —— 抽局、内容校验、界面列背景都用它
func enabled_backgrounds() -> Array:
	var out := []
	for b in BACKGROUNDS:
		if bg_enabled(b):
			out.append(b)
	return out

func background_ids() -> Array:
	var out := []
	for b in enabled_backgrounds():
		out.append(b["id"])
	# 兜底：万一全部被标成草稿，至少还能开局（否则 `ids[0]` 会越界崩掉）
	if out.is_empty():
		for b in BACKGROUNDS:
			out.append(b["id"])
			break
	return out

# ★ 这个数 = **已启用**的背景套数（不是「一共几套」）——
#   测试断言「至少 4 套」、界面报「可用背景 N 套」用的都是它。
func bg_count() -> int:
	return enabled_backgrounds().size()

func all_bg_count() -> int:
	return BACKGROUNDS.size()

func desc_of(item_id: String) -> String:
	return str(ITEM_DESC.get(item_id, ""))

func frame_of(slot: String) -> String:
	return str(CLUE_FRAME.get(slot, "「他%s。」"))

func sources_of(slot: String) -> Array:
	return CLUE_SOURCES.get(slot, ["来源不明"])

# 把「某槽位的原貌物品」拼成一句目击者的话
func clue_text(slot: String, item_id: String) -> String:
	var d := desc_of(item_id)
	if d == "":
		d = "看不真切"
	return frame_of(slot) % d

# 照片的取景框 —— 按**半身**取（第四十三轮起照片是一段身体，不是一处特写）
func photo_focus_half(half: String) -> Rect2:
	return PHOTO_FOCUS_HALF.get(half,
		Rect2(0, 0, DolDoll.frame_size().x, DolDoll.frame_size().y))

# 旧门面：按槽位取景。第四十三轮起没有调用点了（照片不再按槽位裁），
# 保留是为了不破坏外部可能的引用。
func photo_focus(slot: String) -> Rect2:
	return PHOTO_FOCUS.get(slot, Rect2(0, 0, DolDoll.frame_size().x, DolDoll.frame_size().y))

# ============================================================
#  手机相册
#
#  照片是「别人偷拍的 A」—— 糊、有反光、有噪点。玩家可以反复「擦掉反光」
#  把清晰度顶上去；擦到够清楚，才认得出那处原貌。有些照片本身就拍废了，
#  再怎么擦也看不清 —— 这就是「信息不全」。
# ============================================================

# 会出现在相册里的槽位（挑视觉上最有辨识度的那些）
#
# ★ 第四十三轮（用户口径）：「相册里图片的照片只会出现眼镜，发型，上衣，下装，鞋子这五类」。
#   所以这里从原来的 13 类收窄成 **5 类** —— 脖子 / 刺青 / 妆容 / 穿环 / 帽子 /
#   成装 / 外袍 都不再出现在照片里（它们仍走情报台那条线）。
#   ★ 下架的槽位由 RunData._roll_photos() 用 slot_enabled() 兜一层，
#     写在这里是为了将来恢复时不用再改。
const PHOTO_SLOTS := ["glasses", "hair", "top", "bottom", "shoes"]

# 一张照片要么拍**上半身**、要么拍**下半身**，两组不混 —— 用户口径：
#   「如出现下半身时可以同时有下装和鞋子，但不能有头发眼镜，
#     上半身可以同时有眼镜发型上衣，但不能有鞋子」
# 一张照片从它那一组里取件 —— 「可能会同时出现」。
const PHOTO_UPPER := ["glasses", "hair", "top"]
const PHOTO_LOWER := ["bottom", "shoes"]

# ★ 第四十四轮（用户补充口径）：「鞋子、发型、眼镜这三样在**所有照片里各自最多出现一次**」。
#   理由（用户原话）：「因为这三样东西类型太少」——
#   款式越少越怕重复：同一个部位在两三张照片里显示了不同的款，
#   玩家立刻就能把范围缩到那几款里，等于把答案交出去了。
#   所以这三样是**整局共享的名额**：用过就不再出现。
#   ★ 是「最多一次」而不是「恰好一次」—— 可能一次都不出现（用户选的）。
const PHOTO_ONE_OF := ["glasses", "hair", "shoes"]

# 主体 / 点缀各自的出现概率。
#   · 主体（top / bottom）—— 各自独立，每张照片掷一次
#   · 点缀（眼镜 / 发型 / 鞋子）—— 整局掷，且**用过一次就不再出现**
#   都取一半：既能出现「只有上衣」也能出现「只有眼镜」，张张不一样。
#   ★ 兜底：两个都没选中时一定补一件主体，所以照片不会空。
