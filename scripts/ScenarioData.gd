	"silence_delta": 12.0,             # 档案题第 4 项「沉默」的代价（原 6）
	"leak_delta": 100.0,               # 说漏嘴 —— 直接判死（这条**不翻倍**：它本来就是「顶满」）
	"correct_delta": 0.0,              # B 卡照答（轮内只涨不跌，负数会被归零 → 写 0 更直白）
