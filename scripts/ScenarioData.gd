	for t in INTERROGATOR_TRAITS:
		if str(t.get("id", "")) == id:
			return t
	return {}

# 某性情下「撒谎 / 回避」各扣多少怀疑度
# 注意：参数不能叫 `trait` —— 那是 GDScript 的保留字，会直接报 Parse Error。
func trait_delta(tr: Dictionary, kind: String) -> float:
	if kind == "bluff":
		return float(tr.get("bluff_delta", 6.0))
	if kind == "evade":
		return float(tr.get("evade_delta", 3.0))
	return 0.0

func trait_note(tr: Dictionary, kind: String) -> String:
	if kind == "bluff":
		return str(tr.get("bluff_note", ""))
	if kind == "evade":
		return str(tr.get("evade_note", ""))
	return ""

# 这一项是不是「在他面前绝不能选」的那个
func trait_is_dangerous(tr: Dictionary, kind: String) -> bool:
	return str(tr.get("dangerous", "")) == kind

# ---------------- 备忘录里那三条（性格 / 喜好 / 忌讳）----------------
func trait_memo(tr: Dictionary) -> String:
	return str(tr.get("memo", ""))

func trait_like(tr: Dictionary) -> String:
	return str(tr.get("like", ""))

func trait_hate(tr: Dictionary) -> String:
	return str(tr.get("hate", ""))

# 「该怎么答」—— 备忘录第一条最后那一行，也是盲区题唯一的依据。
