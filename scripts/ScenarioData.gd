# ============================================================
#  文本数据的外部来源（data/story.json）
#
#  上面那些 DEFAULT_* 常量是「出厂文本」。游戏真正用的是下面这几个属性 ——
#  首次访问时从 res://data/story.json 读一遍覆盖上去。
#
#  为什么要外置：
#    tools/story_editor.html 是个可视化文本编辑器（短信 / 对话 / 问题 / 选项），
#    它读写的就是 data/story.json。改完存盘，下一局直接生效，不用碰 GDScript。
#
#  回退规则（测试全靠它）：
#    文件不存在 / 打不开 / 解析失败 / 某一段是空的 → 那一段退回 DEFAULT_*。
#    所以把 data/story.json 删了游戏照样跑，只是用回出厂文本。
#
#  重新生成 JSON：godot --headless --path <项目> res://tools/DumpStory.tscn
# ============================================================

const STORY_PATH := "res://data/story.json"

var _story_loaded := false
var story_from_file := false          # 这次到底是从 JSON 读的，还是回退的

var BACKGROUNDS: Array:
	get:
		_ensure_story()
		return _backgrounds

var INTERROGATOR_TRAITS: Array:
	get:
		_ensure_story()
		return _traits

var ITEM_DESC: Dictionary:
	get:
		_ensure_story()
		return _item_desc

var CLUE_FRAME: Dictionary:
	get:
		_ensure_story()
		return _clue_frame

var CLUE_SOURCES: Dictionary:
	get:
		_ensure_story()
		return _clue_sources

var PHOTO_NOTES: Array:
	get:
		_ensure_story()
		return _photo_notes

# 手机的全部界面文案（外壳 / 消息三组 / 备忘录 / 相册 / 备注 / 与审问官的短信）
var PHONE: Dictionary:
	get:
		_ensure_story()
		return _phone

# 全局数值规则（怀疑度增量 / QTE 窗口 / 干扰节奏 / 矛盾上限 / 掏手机代价…）
var RULES: Dictionary:
	get:
		_ensure_story()
		return _rules

# 界面文案（按钮 / 提示条 / 反馈句 / 玩法说明）
var UI: Dictionary:
	get:
		_ensure_story()
		return _ui

var _backgrounds: Array = []
var _traits: Array = []
var _item_desc: Dictionary = {}
var _clue_frame: Dictionary = {}
var _clue_sources: Dictionary = {}
var _photo_notes: Array = []
var _phone: Dictionary = {}
var _rules: Dictionary = {}
var _ui: Dictionary = {}

func _ready() -> void:
	_ensure_story()

func _ensure_story() -> void:
	if _story_loaded:
		return
	_story_loaded = true          # 先置位 —— 否则 _load_story 里读属性会无限递归
	_load_story()

# 给测试 / 工具用：强制重新读一遍
func reload_story() -> void:
	_story_loaded = false
	_ensure_story()

func _load_story() -> void:
	# 先装出厂文本，再让 JSON 逐段覆盖 —— 这样「文件里只写了一半」也不会崩
	_backgrounds = DEFAULT_BACKGROUNDS
	_traits = DEFAULT_TRAITS
	_item_desc = DEFAULT_ITEM_DESC
	_clue_frame = DEFAULT_CLUE_FRAME
	_clue_sources = DEFAULT_CLUE_SOURCES
	_photo_notes = DEFAULT_PHOTO_NOTES
	_phone = DEFAULT_PHONE
	_rules = DEFAULT_RULES
	_ui = DEFAULT_UI
	story_from_file = false

	if not FileAccess.file_exists(STORY_PATH):
		_fill_endings()
		return
	var f := FileAccess.open(STORY_PATH, FileAccess.READ)
	if f == null:
		push_warning("story.json 打不开，回退到内置文本")
		_fill_endings()
		return
	var txt := f.get_as_text()
	f.close()

	var parsed: Variant = JSON.parse_string(txt)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("story.json 解析失败，回退到内置文本")
		_fill_endings()
		return

	var d: Dictionary = parsed
	var bg: Variant = d.get("backgrounds", null)
	if bg is Array and not (bg as Array).is_empty():
		_backgrounds = bg
	var tr: Variant = d.get("traits", null)
	if tr is Array and not (tr as Array).is_empty():
		_traits = tr
	var idesc: Variant = d.get("item_desc", null)
	if idesc is Dictionary and not (idesc as Dictionary).is_empty():
		_item_desc = idesc
	var cframe: Variant = d.get("clue_frame", null)
	if cframe is Dictionary and not (cframe as Dictionary).is_empty():
		_clue_frame = cframe
	var csrc: Variant = d.get("clue_sources", null)
	if csrc is Dictionary and not (csrc as Dictionary).is_empty():
		_clue_sources = csrc
	var pnotes: Variant = d.get("photo_notes", null)
	if pnotes is Array and not (pnotes as Array).is_empty():
		_photo_notes = pnotes
	_phone = _merge_phone(DEFAULT_PHONE, d.get("phone", null))
	# 数值规则与界面文案：**逐键**覆盖出厂默认 —— 只写了三项也照跑
	_rules = _merge_flat(DEFAULT_RULES, d.get("rules", null))
	_ui = _merge_phone(DEFAULT_UI, d.get("ui", null))
	# 第二十三轮新增的三段（都允许空 → 空就退回出厂兜底）：
	#   levels       —— 一局几轮 + 每轮数值（编辑器可增删）
	#   forced_rules —— 每轮的强制服装规则表（固定一件 / 几件选一件的自由组合）
	#   qte_plan     —— 每道题用哪种 QTE、几秒后出现
	_levels_ov = (d.get("levels", []) as Array) if typeof(d.get("levels", null)) == TYPE_ARRAY else []
	_forced_ov = (d.get("forced_rules", []) as Array) if typeof(d.get("forced_rules", null)) == TYPE_ARRAY else []
	_qte_plan_ov = (d.get("qte_plan", []) as Array) if typeof(d.get("qte_plan", null)) == TYPE_ARRAY else []
	# ★★ 第八十三轮（续 2）：全局 `defects` 段**整个不再读** —— 编辑器那一页已删、
	#   数据段也删了（留一份没入口却会生效的数据 = 隐形脏数据）。
	#   缺陷现在完全归每套背景：`backgrounds[].defects`，空数组 = 这套没有缺陷。
	# ★ 第四十轮新增的两段（都可为空 → 空 = 用代码内置值）：
	#   item_overrides —— 服装数值覆写（暴露度 / 接受度）
	#   true_presets   —— 原貌预设（随机池 + 按关覆写）
	_item_ov = (d.get("item_overrides", {}) as Dictionary) \
		if typeof(d.get("item_overrides", null)) == TYPE_DICTIONARY else {}
	_true_presets = (d.get("true_presets", {}) as Dictionary) \
		if typeof(d.get("true_presets", null)) == TYPE_DICTIONARY else {}

	story_from_file = true
	# ★ 第八十一轮：从文件读的 → **不填出厂模板**（没写就是不显示）
	_fill_endings(false)
	# ★ 第四十轮：数据读完就把服装数值覆写应用掉 —— 必须在这里做，
	#   因为 OutfitData 的 autoload 顺序在本文件**之前**（它 _ready 时 story 还没读），
	#   而全项目有 33 处直接读 `OutfitData.ITEMS`，必须在那之前把值改好。
	OutfitData.apply_item_overrides(_item_ov)

# ---------- 第二十三轮：可编辑的三段 ----------
# 读取一律走这三个门面 —— OutfitData / Interrogation 只认它们，
# 不直接碰 JSON，所以「文件里没有这一段」与「这一段是空的」行为一致（都退回出厂兜底）。
var _levels_ov: Array = []
var _forced_ov: Array = []
var _qte_plan_ov: Array = []
# ★ 第八十三轮（续 2）：全局 defects 层已拆掉，不再有 `_defects_ov` / `_defects_declared`。
# ★ 第四十轮
var _item_ov: Dictionary = {}
var _true_presets: Dictionary = {}

func levels_override() -> Array:
	_ensure_story()
	return _levels_ov

func forced_rules_override() -> Array:
	_ensure_story()
	return _forced_ov

# 服装数值覆写（第四十轮）—— {item_id: {exposure, acceptance_req}}
func item_overrides_override() -> Dictionary:
	_ensure_story()
	return _item_ov

# ============================================================
#  第四十一轮：按背景覆写「本局的流程配置」
#
#  用户口径：「每局游戏应该能够设置不同强制穿着，qte计划，身体缺陷，
#            轮次轮数，原貌」。
#
#  做法：这五项都可以**挂在背景上**（`backgrounds[i]`），一套背景一份。
#        背景里写了就用它，没写就回退到全局那份 —— 所以默认（四套背景都不写）
#        的行为与以前**逐字节相同**。
#
#    backgrounds[i].levels        ★ 数组长度 = **本局打几轮**；第 i 项是对全局第 i 关的逐键覆写
#    backgrounds[i].forced_rules  本局的强制穿着表（每轮一条）
#    backgrounds[i].qte_plan      本局的 QTE 计划（按题号对齐）
#    backgrounds[i].defects       本局的身体缺陷表
#    backgrounds[i].true_presets  本局的原貌预设（{pool, by_level}）
#
#  ★ levels 的语义与另外四项**不同**：另外四项是「非空即整份取代」，
#    而 levels 是「非空则长度定关数、逐条按索引覆写」——
#    因为背景原先就用它覆写「每轮叫什么名字 / 推导形象」（那时长度必须等于全局关数）。
#    现在把「长度」也赋予了意义，于是「给某套背景只配 3 关」只要写 3 条即可，
#    而且旧数据（写满 4 条）语义不变。
# ============================================================
func _bg_of(bg_id: String) -> Dictionary:
	_ensure_story()
	if bg_id == "":
		return {}
	for b in _backgrounds:
		if str((b as Dictionary).get("id", "")) == bg_id:
			return b
	return {}

func _as_array(v: Variant) -> Array:
	return (v as Array) if typeof(v) == TYPE_ARRAY else []

# 这套背景覆写的轮次表（空 = 用全局那份）
func bg_levels(bg_id: String) -> Array:
	return _as_array(_bg_of(bg_id).get("levels", null))

func bg_forced_rules(bg_id: String) -> Array:
	return _as_array(_bg_of(bg_id).get("forced_rules", null))

func bg_qte_plan(bg_id: String) -> Array:
	return _as_array(_bg_of(bg_id).get("qte_plan", null))

func bg_defects(bg_id: String) -> Array:
	return _as_array(_bg_of(bg_id).get("defects", null))

# ★ 第八十三轮：这套背景**写过** defects 吗？（`[]` 也算写过 = 这套没有缺陷）
#   有了它才能区分「作者写了空 = 就是没有」和「根本没写 = 用默认」。
func bg_has_defects(bg_id: String) -> bool:
	var bg := _bg_of(bg_id)
	return bg.has("defects") and typeof(bg.get("defects", null)) == TYPE_ARRAY

func bg_true_presets(bg_id: String) -> Dictionary:
	var v: Variant = _bg_of(bg_id).get("true_presets", null)
	return v if typeof(v) == TYPE_DICTIONARY else {}

# 这套背景覆写的原貌预设（清洗 + 按关对齐，与全局那套走同一段逻辑）
func bg_true_preset_pool(bg_id: String) -> Array:
	var d := bg_true_presets(bg_id)
	if d.is_empty():
		return []
	var out := []
	for e in _sanitize_presets(d.get("pool", [])):
		if not (e as Dictionary).is_empty():
			out.append(e)
	return out

func bg_true_preset_by_level(bg_id: String) -> Array:
	var d := bg_true_presets(bg_id)
	if d.is_empty():
		return []
	var raw: Array = _sanitize_presets(d.get("by_level", []))
	var out := []
	for i in OutfitData.level_count():
		out.append(raw[i] if i < raw.size() else {})
	return out

# 导出用：把四套背景各自的覆写原样交出去（DumpStory 走它）
func BG_OVERRIDES_EXPORT(bg: Dictionary) -> Dictionary:
	return {
		"levels": _as_array(bg.get("levels", null)),
		"forced_rules": _as_array(bg.get("forced_rules", null)),
		"qte_plan": _as_array(bg.get("qte_plan", null)),
		"defects": _as_array(bg.get("defects", null)),
		"true_presets": (bg.get("true_presets", {}) as Dictionary) \
			if typeof(bg.get("true_presets", null)) == TYPE_DICTIONARY else {},
	}

# ---------- 本局那份（由 RunData 在开局时灌进来）----------
# ★ 只影响「读」，不影响导出 —— 导出读的是背景/全局那两份原始数据。
var _run_qte_ov: Array = []
var _run_true_presets: Dictionary = {}

func apply_run_qte_plan(bg_id: String) -> void:
	_run_qte_ov = bg_qte_plan(bg_id)

func apply_run_true_presets(bg_id: String) -> void:
	var d := bg_true_presets(bg_id)
	# ★ 第六十二轮：编辑器把「空的原貌覆写」存成 `{"pool": [], "by_level": [null, null]}`。
	#   如果只判 `is_empty()`，它会当成「这套背景覆写了原貌」，把全局那套整段盖掉 ——
	#   抽到这套背景时原貌变成随机、曲线全乱。空池 + 全是空项 = 没覆写。
	_run_true_presets = d if _presets_have_effect(d) else {}

# 这份原貌预设里到底有没有真东西（池子有项，或某一轮写了非空 slots）
func _presets_have_effect(d: Dictionary) -> bool:
	if not _as_array(d.get("pool", null)).is_empty():
		return true
	for e in _as_array(d.get("by_level", null)):
		if typeof(e) == TYPE_DICTIONARY and not (e as Dictionary).is_empty():
			return true
	return false

# 回到「没有本局覆写」的状态（测试 / 退出局时用）
func clear_run_overrides() -> void:
	_run_qte_ov = []
	_run_true_presets = {}

# 原貌预设（第四十轮）—— {pool: [{name, slots}], by_level: [{name, slots} | null]}
#   ★ 第四十一轮：本局背景若覆写了就优先用它。
func true_presets_override() -> Dictionary:
	_ensure_story()
	if not _run_true_presets.is_empty():
		return _run_true_presets
	return _true_presets

# 这一份原貌预设里「随机池」那部分（去掉空项 —— 池子里不该有「不覆写」这个概念）
#   ★ 第四十一轮：本局背景覆写了就优先用背景那份（见 apply_run_true_presets）。
func true_preset_pool() -> Array:
	_ensure_story()
	var out := []
	for e in _sanitize_presets(true_presets_override().get("pool", [])):
		if not (e as Dictionary).is_empty():
			out.append(e)
	return out

# 这一份原貌预设里「按关覆写」那部分 —— 长度对齐轮次数，没配的关是 {}（= 不覆写）
#   ★ 必须保留位置，所以这里**不能**过滤空项。
#   ★ 第四十一轮：用户口径「原貌也是按背景的四关每轮都可以设置不同的」——
#     所以「按关覆写」自然就是「在每套背景里配四关各一套」。
func true_preset_by_level() -> Array:
	_ensure_story()
	var raw: Array = _sanitize_presets(true_presets_override().get("by_level", []))
	var out := []
	for i in OutfitData.level_count():
		out.append(raw[i] if i < raw.size() else {})
	return out

# 预设的清洗：只留「slots 是字典且非空」的那些，并统一成 {name, slots} 形状。
#   ★ 编辑器可能留下 null / 空对象（「这一轮不覆写」），这里一律转成空字典，
#     由调用方判断「空 = 不覆写」。
func _sanitize_presets(raw: Variant) -> Array:
	var out := []
	if typeof(raw) != TYPE_ARRAY:
		return out
	for e in (raw as Array):
		if typeof(e) != TYPE_DICTIONARY:
			out.append({})          # null / 非字典 → 空（= 不覆写）
			continue
		var slots: Variant = (e as Dictionary).get("slots", null)
		if typeof(slots) != TYPE_DICTIONARY or (slots as Dictionary).is_empty():
			out.append({})
			continue
		var clean := {}
		for k in (slots as Dictionary).keys():
			var s := str(k)
			var iid := str((slots as Dictionary)[k])
			# 只留「这件真的存在于那个槽位」的项 —— 一份手改坏的预设不该让游戏崩
			var it: Dictionary = OutfitData.get_item(iid)
			if it.is_empty() or str(it.get("slot", "")) != s:
				continue
			clean[s] = iid
		if clean.is_empty():
			out.append({})
			continue
		out.append({
			"name": str((e as Dictionary).get("name", "")),
			"slots": clean,
		})
	return out

# 导出用（DumpStory）：把当前生效的覆写与预设原样交出去
func ITEM_OVERRIDES_EXPORT() -> Dictionary:
	return item_overrides_override()

func TRUE_PRESETS_EXPORT() -> Dictionary:
