func phone_text(path: String, fallback: String = "") -> String:
	var cur: Variant = PHONE
	for part in path.split("."):
		if typeof(cur) != TYPE_DICTIONARY:
			return fallback
		var d: Dictionary = cur
		if not d.has(part):
			return fallback
		cur = d[part]
	return str(cur)

# ---------------- 与审问官的短信（★ 第五十五轮：与另外两组同构） ----------------
# 结构完全一样（id / level / contact / avatar / messages），区别只有一条：
# **没有 reveals** —— 他不给你口径，他只是让你知道他已经注意到你了。
func interrogator_sms_of(bg: Dictionary) -> Array:
	return bg.get("interrogator_sms", [])

func get_interrogator_sms(bg: Dictionary, sms_id: String) -> Dictionary:
	for t in interrogator_sms_of(bg):
		if str(t.get("id", "")) == sms_id:
			return t
	return {}

func interrogator_sms_for_level(bg: Dictionary, li: int) -> Array:
	var out := []
	for t in interrogator_sms_of(bg):
		if int(t.get("level", 0)) <= li:
			out.append(t)
	return out

# ---------------- 取值助手 ----------------
# 点号路径取界面文案：ui_t("interrogation.qte_prompt")
# 找不到任何一段就返回 fallback —— 调用点传一个「出厂那句」当兜底，
# 于是即使编辑器把键名写错，游戏也只会退回出厂文案，不会变成空白。
func ui_t(path: String, fallback: String = "") -> String:
	var cur: Variant = UI
	for part in path.split("."):
		if typeof(cur) != TYPE_DICTIONARY:
			return fallback
		var d: Dictionary = cur
		if not d.has(part):
			return fallback
		cur = d[part]
	if typeof(cur) == TYPE_STRING:
		return str(cur)
	return fallback

# 点号路径取界面文案里的数组（玩法说明的三套标注）
func ui_arr(path: String, fallback: Array = []) -> Array:
	var cur: Variant = UI
	for part in path.split("."):
		if typeof(cur) != TYPE_DICTIONARY:
			return fallback
		var d: Dictionary = cur
		if not d.has(part):
			return fallback
		cur = d[part]
	if typeof(cur) == TYPE_ARRAY and not (cur as Array).is_empty():
		return cur
	return fallback

# 数值：键不存在 / 类型不对 → 退回 dflt（调用点传那个「出厂常量」）
func rule_f(key: String, dflt: float) -> float:
	var v: Variant = RULES.get(key, null)
	if typeof(v) == TYPE_FLOAT or typeof(v) == TYPE_INT:
		return float(v)
	return dflt

func rule_i(key: String, dflt: int) -> int:
	return int(round(rule_f(key, float(dflt))))

func rule_arr(key: String, dflt: Array = []) -> Array:
	var v: Variant = RULES.get(key, null)
	if typeof(v) == TYPE_ARRAY and not (v as Array).is_empty():
		return v
	return dflt


# 从 DEFAULT_UI 里按同一条路径取兜底 —— 给「写死一段文案不能为空」的场合用。
# 例：ui_t_d("interrogation.qte_prompt") —— 文件里没有就取出厂那句。
func ui_t_d(path: String) -> String:
	var d: Variant = _default_at(path)
	return ui_t(path, str(d) if typeof(d) == TYPE_STRING else "")

func ui_arr_d(path: String) -> Array:
	var d: Variant = _default_at(path)
	return ui_arr(path, d if typeof(d) == TYPE_ARRAY else [])

func _default_at(path: String) -> Variant:
	var cur: Variant = DEFAULT_UI
	for part in path.split("."):
		if typeof(cur) != TYPE_DICTIONARY:
			return ""
		var d: Dictionary = cur
		if not d.has(part):
			return ""
		cur = d[part]
	return cur

# ---------------- 结局文案 ----------------
# ★ 第八十一轮（用户口径「结局文案中所有的部分不写默认不使用」）：
#   只认数据里**写了**的那几条 —— 没写 / 空串 = 这一句不显示，
#   **不再**逐键回填出厂模板（以前缺一个键就冒出模板那句）。
#
#   唯一的例外是「这套背景连 endings 这个键都没有」（内置常量 / 很老的数据）——
#   那时退回 DEFAULT_ENDINGS，否则把 story.json 删掉之后演示都跑不起来。
#   从文件读到的背景由 _fill_endings(false) 保证一定有 endings 这个键（可能是 {}），
#   所以正常游戏里走不到那条例外。
func endings_of(bg: Dictionary) -> Dictionary:
	var e: Variant = bg.get("endings", null)
	if typeof(e) == TYPE_DICTIONARY:
		return e
	return DEFAULT_ENDINGS

# 取一条结局文案。**没写就是空串**（不显示），不再接受调用点的兜底句 ——
# 兜底句会让人以为「改了数据」，其实看的是代码里那句。
func end_t(bg: Dictionary, key: String) -> String:
	var v: Variant = endings_of(bg).get(key, null)
	if typeof(v) == TYPE_STRING:
		return str(v)
	return ""

# ============================================================
#  数值规则（rules）—— 出厂默认
#
#  这些原本是散在 Interrogation.gd 里的 const。提到这里之后，
#  data/story.json 的 "rules" 段可以逐项覆盖它们 —— 编辑器一改就生效。
#
#  ★ 什么**不**在这里：
#    · 版式几何（QTE_FROM_BOTTOM / INTF_FROM_BOTTOM / STRIP_BAND_H）——
#      那是「720 高的屏怎么摆」，改了会直接把版式弄坏，不是玩法数值；
#    · 服装体系（接受度曲线 / 反差要求 / 暴露上限 / 强制装备）——
#      用户口径：服装相关的留到下一轮。
# ============================================================
const DEFAULT_RULES := {
	# --- 盘问流程 ---
	"questions_per_level": 6,          # 一关问几道（第五十轮：8 → 6）
	# ★ 第二十九轮：反差值要求曲线 —— 留空的轮次 = 上一轮 + step（见 OutfitData._resolve_contrast_req）
	"contrast_req_base": 125,           # 第 1 关的反差要求基线
	"contrast_req_step": 15,           # 之后每轮自增多少
	"contrast_per_exposure": 5,        # 反差值：每一档暴露度差算多少分（第三十一轮新算法）
	# ★★ 第八十五轮（用户口径）：「同暴露值的不同件衣服增加 2 分，发型、妆容多加点」。
	#   以前反差只认 |暴露值差| —— 换一件完全不同、但暴露值相同的衣服记 0 分，
	#   于是发型（7 件全是露 0）、眼镜、妆、鞋这几栏怎么换都不涨分。
	#   现在：**换了不同的一件 + 暴露值没变** → 再加这档分（槽位专属值优先）。
	"contrast_same_exposure_bonus": 2,   # 同暴露值、不同件的基础分（所有槽位）
	"contrast_bonus_hair": 12,           # 发型多给（一眼就能看出换了个人）
	"contrast_bonus_makeup": 10,         # 妆容同理
	# ★★ 第七十五轮（用户口径「过关线修改为 100」）：过关线 60 → 100。
	#    怀疑度本来就是 0~100 的条，100 是「当场暴露」那一下 —— 线抬到 100 之后，
	#    真正判死的只剩「顶满」这一种。原来按 60 那条线配的增量就全都偏轻了
	#    （全沉默一轮只涨 36，连一半都不到），所以这一整组**同步翻倍**：
	#      · 起点仍是 20 → 一轮的预算 = 100 − 20 = **80**（原来是 40）；
	#      · 6 道题全沉默 = 6 × 12 = 72 → 92（险过 8），和旧版「全沉默 56 / 线 60」同档；
	#      · 一次最贵的撒谎（多疑 90）= 110 → 当场死，和旧版「45 → 65 / 线 60」同档。
	#    换句话说：翻倍不是「变难」，是把难度曲线**原样搬到 100 这条线上**。
	"pass_suspicion": 100.0,           # 怀疑度低于它才算过（= 顶满就死）
