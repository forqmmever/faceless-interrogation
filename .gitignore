# Godot 生成的导入缓存（11MB，可随时重建，不进版本库）
.godot/

# Godot 导出产物
export.cfg
export_presets.cfg
*.translation
build/
export/

# 临时/中间文件（.workbuddy-ai/memory 要留，tmp 不留）
.workbuddy-ai/tmp/

# 编辑器与系统杂项
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 编辑器保存时留的上一版备份（tools/story_server.py 生成）
data/story.json.bak
data/story.json.tmp

# 编辑器每次保存前留的时间戳备份（tools/story_server.py 生成，留最近 30 份）
data/backups/

# 日志
*.log
