# 编辑器用的**只读目录**：有哪些衣服、有哪些标签、有哪些槽位。
#   ★ 存在的理由：编辑器只读 story.json，看不到 OutfitData.ITEMS ——
#     而「强制穿哪几件」「缺陷用哪些标签判遮挡」都得从真实物品里挑，
#     手打 id 一定会打错。所以把目录一起导出去，编辑器拿它做下拉 / 勾选。
#     游戏本身**不读**这一段（多一个键不影响），纯给编辑器用。
func CATALOG_EXPORT() -> Dictionary:
	var items := []
	for it in OutfitData.ITEMS:
		var slot := str(it.get("slot", ""))
		items.append({
			"id": str(it.get("id", "")),
			"name": str(it.get("name", "")),
			"slot": slot,
			"slot_name": str(OutfitData.SLOT_NAMES.get(slot, slot)),
			"exposure": int(it.get("exposure", 0)),
			"contrast": int(it.get("contrast", 0)),
			"acceptance_req": int(it.get("acceptance_req", 0)),
			"tags": (it.get("tags", []) as Array).duplicate(),
			"disabled": not OutfitData.slot_enabled(slot),
		})
	# 全部出现过的标签（去重、排序）—— 缺陷的 cover_tags 从这里挑
	var tags := {}
	for it in OutfitData.ITEMS:
		for t in it.get("tags", []):
			tags[str(t)] = true
	var tag_list := tags.keys()
	tag_list.sort()
	return {
		"items": items,
		"tags": tag_list,
		"slots": OutfitData.SLOT_ORDER.duplicate(),
		"slot_names": OutfitData.SLOT_NAMES.duplicate(),
		"active_slots": OutfitData.active_slots(),
		"disabled_slots": OutfitData.DISABLED_SLOTS.duplicate(),
		# ★ 第三十九轮：告诉编辑器哪些槽位是「只能手动装备」的（界面上看得到，
		#   但不参与原貌 / 强制 / 一键达标 / 反差统计）。目前只有 tool 一栏。
		"manual_slots": OutfitData.MANUAL_SLOTS.duplicate(),
		# ★ 第四十轮新增两样，都是给「服装数值编辑器 / 原貌编辑器」用的：
		#   base_values —— 每件的**代码内置**数值。编辑器拿它跟 items 里的当前值
		#                  对比，就能标出「这一件被覆写改过」并支持一键还原。
		#                  注意 items 里已经是**应用过覆写之后**的值。
		#   true_pool    —— 每槽位的原貌候选（TRUE_POOL）。原貌编辑器用它做
		#                  「这一件符不符合 A 的原貌」的提示与「一键套用原貌」。
		"base_values": _catalog_base_values(),
		"true_pool": OutfitData.TRUE_POOL.duplicate(true),
	}

# 每件物品的**代码内置**数值（不读运行期那份 —— 它可能已被覆写改过）
func _catalog_base_values() -> Dictionary:
	var out := {}
	for it in OutfitData.ITEMS_BASE:
		out[str(it.get("id", ""))] = {
			"exposure": int(it.get("exposure", 0)),
			"acceptance_req": int(it.get("acceptance_req", 0)),
		}
	return out

# 第 li 道题的 QTE 计划；没写这一道 → 返回空字典（调用方按「自动」处理）
func qte_plan_at(li: int) -> Dictionary:
	_ensure_story()
	# ★ 第四十一轮：本局背景覆写了 QTE 计划就优先用它（见 apply_run_qte_plan）
	var src: Array = _run_qte_ov if not _run_qte_ov.is_empty() else _qte_plan_ov
	if li < 0 or li >= src.size():
		return {}
	var e: Variant = src[li]
	return e if typeof(e) == TYPE_DICTIONARY else {}

func qte_plan() -> Array:
	_ensure_story()
	return _qte_plan_ov

func set_qte_plan(arr: Array) -> void:
	_qte_plan_ov = arr

# 结局文案：每套背景一份。
#
# ★★ 第八十一轮：**不再逐键回填出厂模板**（用户口径「不写默认不使用」）。
#   · 从文件读进来的一份 → 原样保留，没写的键读出来是空串 → 界面上什么都不显示；
#   · 只有「根本没有 story.json」那条兜底路径才填 DEFAULT_ENDINGS，
#     否则演示用的出厂背景会整片空白（那是「数据缺失」，不是「作者没写」）。
# ★ 两处都必须先 duplicate：`_backgrounds` 可能直接指向只读常量数组。
func _fill_endings(use_defaults: bool = true) -> void:
	_backgrounds = _backgrounds.duplicate(true)
	for i in _backgrounds.size():
		var bg: Dictionary = (_backgrounds[i] as Dictionary).duplicate(true)
		var cur: Variant = bg.get("endings", null)
		if use_defaults:
			bg["endings"] = _merge_flat(DEFAULT_ENDINGS, cur)
		elif typeof(cur) != TYPE_DICTIONARY:
			# 从文件来、但这套背景没写 endings —— 补一个空字典，
			# 这样 endings_of() 不会把它当成「内置常量」而退回出厂模板。
			bg["endings"] = {}
		_backgrounds[i] = bg

# 扁平字典的合并：base 的每个键都保留，over 里有的就换掉。
# 数组**不**当「没写」—— 结局文案里没有数组，但玩法说明的标注是数组，
# 那个走 _merge_phone 那条路（数组整段替换）。
func _merge_flat(base: Dictionary, over: Variant) -> Dictionary:
	var out: Dictionary = base.duplicate(true)
	if typeof(over) != TYPE_DICTIONARY:
		return out
	for k in (over as Dictionary).keys():
		var v: Variant = (over as Dictionary)[k]
		if v != null:
			out[k] = v
	return out

# 手机文案的合并：**逐段**覆盖。
#   story.json 里只写了「messages」这一段，其余（外壳 / 备忘录 / 相册 / 备注 /
#   与审问官的短信）仍然用出厂文本 —— 半份数据不会把手机搞成空白。
func _merge_phone(base: Dictionary, over: Variant) -> Dictionary:
	var out: Dictionary = base.duplicate(true)
	if typeof(over) != TYPE_DICTIONARY:
		return out
	for k in (over as Dictionary).keys():
		var v: Variant = (over as Dictionary)[k]
		if typeof(v) == TYPE_DICTIONARY and typeof(out.get(k, null)) == TYPE_DICTIONARY:
			var merged: Dictionary = (out[k] as Dictionary).duplicate(true)
			for kk in (v as Dictionary).keys():
				merged[kk] = (v as Dictionary)[kk]
			out[k] = merged
		elif typeof(v) == TYPE_ARRAY:
			# 空数组当「没写」—— 否则一次误存就会把与审问官的短信清空
			if not (v as Array).is_empty():
				out[k] = v
		elif v != null:
			out[k] = v
	return out

# ============================================================
#  本局固定主人公的性别（用户定的设定）
#    A = 真身（玩家）    → 女
#    B = 马甲（玩家装的）→ 女
#    审讯官（被欺骗的人）→ 男（见 background.interrogator_gender）
#    C = 同行人          → 男（见 companion.gender）
# ============================================================
const PLAYER_GENDER := "女"

# ============================================================
#  查询接口（按背景）
# ============================================================
func facts_of(bg: Dictionary) -> Array:
	return bg.get("facts", [])

func sms_of(bg: Dictionary) -> Array:
	return bg.get("sms", [])

# ---------------- 与 C 的短信 ----------------
# 和剧情短信同构（id / level / contact / avatar / messages），但**没有 reveals** ——
# C 不给你口径，他只是让你知道：他知道你是谁，而且他就在旁边。
# 单开一个数组而不是塞进 sms[]，是为了让「三个分组」在数据层面就是三份东西。
func companion_sms_of(bg: Dictionary) -> Array:
	return bg.get("companion_sms", [])

func get_companion_sms(bg: Dictionary, sms_id: String) -> Dictionary:
	for t in companion_sms_of(bg):
		if str(t.get("id", "")) == sms_id:
			return t
	return {}

func companion_sms_for_level(bg: Dictionary, li: int) -> Array:
	var out := []
	for t in companion_sms_of(bg):
		if int(t.get("level", 0)) <= li:
			out.append(t)
	return out

func companion_questions_of(bg: Dictionary) -> Array:
	return bg.get("companion_questions", [])

# ---------------- 开场介绍（弹出式浮动窗口）----------------
#  一局开始时弹出来，把「这是哪儿 / 你是谁 / 谁在对面 / 谁在旁边」讲清楚。
#  玩家可以随时点按钮再打开一次（见 Main._show_intro）。
func venue_of(bg: Dictionary) -> String:
	return str(bg.get("venue", ""))

func intro_of(bg: Dictionary) -> String:
	var t := str(bg.get("intro", ""))
	return t if t != "" else venue_of(bg)

# ---------------- 盲区题（「完全没给信息的题」）----------------
# 他问一件档案里没有、短信里也没提的事。题面不指向任何一张卡，
# 所以手里真的一点底都没有 —— 唯一的依据是手机备忘录第一条（他的性情）。
func blind_questions_of(bg: Dictionary) -> Array:
	return bg.get("blind_questions", [])

# 第 li 关固定用第 li 条 —— 一局里不重复，也方便测试
func blind_question_for_level(bg: Dictionary, li: int) -> Dictionary:
	var arr := blind_questions_of(bg)
	if arr.is_empty():
		return {}
	return arr[li % arr.size()]

# ---------------- 本局固定主人公（一局之内绝不改变）----------------
# 审讯官、同行人、A、B 全部来自**背景**，而背景是每局抽一次、跨关不重抽的
# （见 RunData.advance_level）。所以这四个人在一局里天然不会变 ——
# 这里只是给他们一个统一的出处，省得各处各自去查背景。
func interrogator_of(bg: Dictionary) -> String:
	return str(bg.get("interrogator", "审讯官"))

# 题目来源（★ 第五十六轮）："manual" = 用户自己写题、不建档案卡与事实。
#   缺省 "auto" —— 出厂那四套不写这个键，行为与以前一模一样。
#   ★ 运行时只有两处读它：① 判定「盲区题」时要关掉（没有档案就没有盲区）；
#     ② 选项没有 tone 时按「照实答」结算。其余一切都还是数据驱动。
func questions_source_of(bg: Dictionary) -> String:
	return "manual" if str(bg.get("questions_source", "")) == "manual" else "auto"

func true_role_of(bg: Dictionary) -> String:
	return str(bg.get("true_role", ""))

# A 的**真身名字** —— 一局只有一次机会听见它：门开那一刻，他认出你的时候。
# 平时它不出现在任何地方（连你自己都不念），所以他一旦说出口，就是宣判。
func true_name_of(bg: Dictionary) -> String:
	var n := str(bg.get("true_name", ""))
	return n if n != "" else true_role_of(bg)

func companion_of(bg: Dictionary) -> Dictionary:
	return bg.get("companion", {})

func companion_name_of(bg: Dictionary) -> String:
	var c := companion_of(bg)
	return str(c.get("name", "同行者"))

func companion_relation_of(bg: Dictionary) -> String:
	var c := companion_of(bg)
	return str(c.get("relation", "同行者"))

func companion_desc_of(bg: Dictionary) -> String:
	var c := companion_of(bg)
	return str(c.get("desc", ""))

func companion_gender_of(bg: Dictionary) -> String:
	var c := companion_of(bg)
	return str(c.get("gender", "男"))

func interrogator_gender_of(bg: Dictionary) -> String:
	return str(bg.get("interrogator_gender", "男"))

func get_fact(bg: Dictionary, fact_id: String) -> Dictionary:
	for f in facts_of(bg):
		if str(f.get("id", "")) == fact_id:
			return f
	return {}

func fact_value_label(bg: Dictionary, fact_id: String, value_id: String) -> String:
	var f := get_fact(bg, fact_id)
	for v in f.get("values", []):
		if str(v.get("id", "")) == value_id:
			return str(v.get("label", ""))
	return ""

# values[0] 是 B 的官方说法
func canonical_value(bg: Dictionary, fact_id: String) -> String:
	var f := get_fact(bg, fact_id)
	var vals: Array = f.get("values", [])
	if vals.is_empty():
		return ""
	return str(vals[0].get("id", ""))

func get_sms(bg: Dictionary, sms_id: String) -> Dictionary:
	for t in sms_of(bg):
		if str(t.get("id", "")) == sms_id:
			return t
	return {}

# ---------------- 短信逐关解锁 ----------------
# 每条短信带一个 level（0 起）——「打到第几轮才解锁」。
# 第 i 关解锁的那一条，正好揭示 facts[i] 的官方口径，
# 也就是本轮新要问的那个说法。所以信息是**渐进**给出的，
# 不是开局一次性全塞给你。
func sms_level_of(sms: Dictionary) -> int:
	return int(sms.get("level", 0))

func sms_for_level(bg: Dictionary, li: int) -> Array:
	var out := []
	for t in sms_of(bg):
		if sms_level_of(t) <= li:
			out.append(t)
	return out

func companion_question_for(bg: Dictionary, fact_id: String) -> Dictionary:
	for c in companion_questions_of(bg):
		if str(c.get("fact", "")) == fact_id:
			return c
	return {}

