const PHOTO_ONE_OF_CHANCE := 0.5    # 每张照片「要不要用掉一个点缀名额」的概率

const PHOTO_HALF_UPPER := "上半身"
const PHOTO_HALF_LOWER := "下半身"

# 照片数量 —— 用户口径：「照片数量每局开始时有三个，每轮增加两个」。
#   ★ 「增加」按**累加**理解：第 1 轮 3 张 → 第 2 轮 5 张 → 第 3 轮 7 张 → 第 4 轮 9 张。
